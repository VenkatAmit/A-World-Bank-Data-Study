# Airflow
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:2.8.1
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here

# Postgres (Airflow metadata DB)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Pipeline DB (separate from Airflow metadata)
PIPELINE_DB_USER=pipeline
PIPELINE_DB_PASSWORD=pipeline123
PIPELINE_DB_NAME=worldbank_pipeline
PIPELINE_DB_HOST=pipeline_db
PIPELINE_DB_PORT=5432

# Data path — point this to your local CSV file
DATA_PATH=/opt/airflow/data/imputed_data_less_than_70_missing.csv
