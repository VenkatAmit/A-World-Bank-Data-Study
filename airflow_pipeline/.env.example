# Airflow core
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:2.8.1
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_webserver_secret_here

# Airflow metadata Postgres
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Pipeline Postgres (World Bank pipeline)
PIPELINE_DB_USER=pipeline
PIPELINE_DB_PASSWORD=pipeline123
PIPELINE_DB_NAME=worldbank_pipeline
PIPELINE_DB_HOST=pipelinedb
PIPELINE_DB_PORT=5432

# Source data path inside container
# Put your CSV at airflow_pipeline/data/imputeddatalessthan70missing.csv
DATAPATH=/opt/airflow/data/imputeddatalessthan70missing.csv
